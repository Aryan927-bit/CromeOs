name: Build ChromaOS APK

on:
workflow_dispatch:
push:
paths:
- 'ChromaOS-AndroidStudio-Project.zip'
- '.github/workflows/build-apk.yml'

jobs:
build:
runs-on: ubuntu-latest

steps:
  - name: Checkout repository
    uses: actions/checkout@v4

  - name: Extract Android project
    run: |
      unzip -q ChromaOS-AndroidStudio-Project.zip -d project
      ls -la project/ChromaOS

  - name: Set up Java
    uses: actions/setup-java@v4
    with:
      distribution: temurin
      java-version: '17'

  - name: Set up Android SDK
    uses: android-actions/setup-android@v3

  - name: Install Gradle
    uses: gradle/actions/setup-gradle@v4
    with:
      gradle-version: '8.9'

  - name: Build debug APK
    working-directory: project/ChromaOS
    run: gradle --no-daemon assembleDebug

  - name: Upload APK
    uses: actions/upload-artifact@v4
    with:
      name: ChromaOS-debug-APK
      path: project/ChromaOS/app/build/outputs/apk/debug/app-debug.apk
      if-no-files-found: error
      retention-days: 7
